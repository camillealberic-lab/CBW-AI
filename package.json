{
  "name": "dicta-ai",
  "productName": "CBW AI",
  "version": "1.0.0",
  "description": "Dictée vocale locale (Whisper) + nettoyage LLM léger, insertion dans l'app active. macOS.",
  "main": "dist/main/main.js",
  "private": true,
  "cbw": {
    "repo": "camillealberic-lab/CBW-AI"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && bash scripts/build-fnwatch.sh && electron .",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p .",
    "setup:whisper": "bash scripts/setup-whisper.sh",
    "setup:whisper:small": "bash scripts/setup-whisper.sh small",
    "icon": "bash scripts/make-icns.sh",
    "dist": "npm run build && npm run build:fnwatch && npm run icon && electron-builder --mac dir --arm64",
    "dist:dmg": "npm run build && npm run build:fnwatch && npm run icon && electron-builder --mac dmg --arm64 && node scripts/stable-dmg.mjs",
    "install-app": "npm run dist && bash scripts/install-app.sh",
    "build:fnwatch": "bash scripts/build-fnwatch.sh",
    "dmg:background": "SDKROOT=/Library/Developer/CommandLineTools/SDKs/MacOSX26.sdk swift scripts/make-dmg-bg.swift build && tiffutil -cathidpicheck build/dmg-bg.png build/dmg-bg@2x.png -out build/background.tiff && rm build/dmg-bg.png build/dmg-bg@2x.png",
    "dist:release": "npm run build && npm run build:fnwatch && npm run icon && bash scripts/package-release.sh",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "com.dicta-ai.app",
    "productName": "CBW AI",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!dist/design/**/shots/**",
      "!dist/design/**/frames/**",
      "!dist/design/**/frames-*/**",
      "!dist/design/preloader/**",
      "!dist/design/cbw-ref/**",
      "!dist/design/brand/previous/**",
      "!dist/design/brand/preview.html",
      "!dist/design/**/*-demo.html",
      "!dist/design/**/demo.html",
      "!dist/design/app/notes-demo*",
      "!dist/design/app/notes-[abc].js",
      "!dist/design/app/notes-previous.js",
      "!dist/design/app/charts-demo.html",
      "!dist/**/*.md"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-arm64/**"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "vendor/bin",
        "to": "bin",
        "filter": [
          "whisper-*",
          "dicta-fnwatch"
        ]
      },
      {
        "from": "assets/tray",
        "to": "assets/tray"
      },
      {
        "from": "assets/icon.png",
        "to": "assets/icon.png"
      },
      {
        "from": "assets/sounds",
        "to": "assets/sounds",
        "filter": [
          "*.wav"
        ]
      }
    ],
    "afterPack": "scripts/after-pack.cjs",
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "14.0",
      "extendInfo": {
        "LSUIElement": false,
        "NSMicrophoneUsageDescription": "CBW AI utilise le micro pour transcrire votre dictée en local, sur votre Mac.",
        "NSAudioCaptureUsageDescription": "CBW AI enregistre le son du Mac pendant une prise de notes (visio, appel) pour transcrire aussi vos interlocuteurs, en local."
      }
    },
    "dmg": {
      "title": "CBW AI",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "background": "build/background.tiff",
      "icon": "build/icon.icns",
      "iconSize": 96,
      "format": "ULFO",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "electronLanguages": [
      "fr",
      "en"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "uiohook-napi": false
  }
}
